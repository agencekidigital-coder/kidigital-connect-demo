{
  "name": "naitea-beta",
  "version": "0.1.0",
  "private": true,
  "description": "Préparation de l’aperçu Naïtea sur le compte Cloudflare de la fondatrice.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:cloudflare": "node scripts/build-cloudflare.cjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "dev:cloudflare": "wrangler dev --ip 127.0.0.1 --port 4194",
    "check:cloudflare": "wrangler deploy --dry-run --outdir dist/worker"
  },
  "devDependencies": {
    "wrangler": "4.168.0"
  }
}
