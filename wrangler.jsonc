{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naitea-beta",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "build": {
    "command": "npm test && npm run build:cloudflare"
  },
  "vars": {
    "NAITEA_AUTH_ENABLED": "true",
    "NAITEA_PROFILE_ENABLED": "true",
    "NAITEA_WORKSHOPS_ENABLED": "false",
    "NAITEA_PUBLICATION_ENABLED": "false",
    "NAITEA_BOOKINGS_ENABLED": "false"
  },
  "observability": {
    "enabled": false
  },
  "previews": {
    "vars": {
      "NAITEA_AUTH_ENABLED": "true",
      "NAITEA_PROFILE_ENABLED": "true",
      "NAITEA_WORKSHOPS_ENABLED": "true",
      "SUPABASE_URL": "https://eedbpqawsrkopoonqpbx.supabase.co",
      "NAITEA_PUBLICATION_ENABLED": "true",
      "NAITEA_BOOKINGS_ENABLED": "true",
      "NAITEA_TURNSTILE_SITE_KEY": "0x4AAAAAAGTHf55e8Mb1ah3c",
      "NAITEA_BOOKING_SENDER": "contact@naitea.fr",
      "NAITEA_BOOKING_ORIGIN": "https://feature-naitea-workshops-persistence-naitea-beta.agence-kidigital.workers.dev",
      "NAITEA_BOOKING_TEST_EMAIL": "contact@naitea.fr",
      "NAITEA_STRIPE_TEST_ENABLED": "true",
      "NAITEA_WORKSHOP_CHECKOUT_TEST_ENABLED": "true"
    }
  }
}
